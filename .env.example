# UniCare Connect - environment variables.
# Copy to .env.local and fill in. NEVER commit real values (.env.local is git-ignored).

# --- Demo mode -------------------------------------------------------------
# true = run with built-in sample data, no MongoDB/Firebase required.
# (Demo mode is also enabled automatically when MONGODB_URI is empty.)
NEXT_PUBLIC_DEMO_MODE=true

# --- MongoDB Atlas ---------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=
# Dev only, for self-signed certificates. Never enable in production.
MONGODB_TLS_INSECURE=false

# --- Firebase Authentication (Firebase console > Project settings > General) --
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-side verification key (same Web API key as above is fine)
FIREBASE_WEB_API_KEY=

# --- C1: blockchain fund ledger (optional) ---------------------------------
# Leave empty to show the bundled LOCAL SIMULATION ledger.
# Fill in all three to read LIVE events from a deployed ScholarshipEscrow contract.
# The web app only READS the chain - it never holds a private key.
C1_RPC_URL=
C1_ESCROW_ADDRESS=
# Block in which the contract was deployed (printed by `npm run deploy:sepolia` in /blockchain).
C1_DEPLOY_BLOCK=
# Secret salt for pseudonymous student refs: studentRef = keccak256("<platform user id>:<salt>").
# Admins must award with the same formula; it lets students get notifications for their own
# on-chain awards and payments (FR11). Keep it secret and never change it once awards exist.
C1_STUDENT_REF_SALT=
