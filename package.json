{
  "name": "unicare-connect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "c1:eval-matching": "tsx scripts/c1/evaluate-matching.ts",
    "c1:demo-cases": "tsx scripts/c1/demo-cases-report.ts",
    "c1:ml": "python ml/synthetic_data.py && python ml/train_vulnerability.py",
    "c1:chain:test": "npm --prefix blockchain test",
    "c3:ml": "python ml/c3/run_pipeline.py",
    "c3:test:py": "python -m pytest tests/unit/c3 -q",
    "c3:benchmark": "tsx scripts/c3/benchmark.ts",
    "c2:data": "python ml/c2/train_text.py download",
    "c2:ml": "python ml/c2/train_text.py train",
    "c2:test": "jest --runInBand tests/unit/c2",
    "c2:demo": "tsx scripts/c2/demo-model.ts",
    "c2:support:data": "python ml/c2/generate_support_cases.py",
    "c2:support:train": "python ml/c2/train_support.py",
    "c2:support:audit": "python ml/c2/test_support.py",
    "c2:research:seed": "node scripts/c2/seed-research-professionals.cjs",
    "c2:communities:seed": "node scripts/c2/seed-research-communities.cjs",
    "c2:communities:verify": "node scripts/c2/seed-research-communities.cjs --verify",
    "c2:followups:seed": "node scripts/c2/seed-followup-questions.cjs",
    "c2:followups:verify": "node scripts/c2/seed-followup-questions.cjs --verify",
    "c2:models:verify": "node scripts/c2/model-assets.cjs verify",
    "c2:models:download": "node scripts/c2/model-assets.cjs download",
    "c2:models:install": "node scripts/c2/model-assets.cjs install",
    "c2:neural:benchmark": "python ml/c2/train_distilbert.py benchmark",
    "c2:neural:train": "python ml/c2/train_distilbert.py train --mask-ablation",
    "c2:neural:audit": "python ml/c2/audit_distilbert.py",
    "c2:neural:export": "python ml/c2/export_distilbert.py",
    "c2:concerns:data": "python ml/c2/generate_concern_cases_v2.py",
    "c2:concerns:train": "python ml/c2/train_concerns.py --run-id c2-distilbert-concerns-v2 --data-dir ml/c2/data/synthetic/concerns-v2 --selected-rate-only --epochs 4",
    "c2:concerns:audit": "python ml/c2/audit_concerns.py --run-id c2-distilbert-concerns-v2 --data-dir ml/c2/data/synthetic/concerns-v2",
    "c2:concerns:export": "python ml/c2/export_concerns.py --run-id c2-distilbert-concerns-v2 --data-dir ml/c2/data/synthetic/concerns-v2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@svg-maps/sri-lanka": "^2.0.0",
    "clsx": "^2.1.1",
    "docx": "^9.5.3",
    "ethers": "^6.17.0",
    "file-saver": "^2.0.5",
    "firebase": "^10.12.5",
    "framer-motion": "^12.34.0",
    "jszip": "3.10.2",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.8.0",
    "next": "14.2.35",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.4",
    "twilio": "^5.2.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
